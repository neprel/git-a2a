{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-a2a.com/schema/a2amodule.v1.json",
  "title": "a2amodule.yml",
  "type": "object",
  "required": ["schema", "module"],
  "properties": {
    "schema": { "const": 1 },
    "module": { "$ref": "#/$defs/module" },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
    "policy": { "$ref": "#/$defs/policy" },
    "settings": { "$ref": "#/$defs/settings" },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "extensionObject": {
      "type": "object",
      "patternProperties": { "^x-": {} }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/])|(?:^|/)\\.\\.(?:/|$)" }
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "module": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/moduleId" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "surface": { "$ref": "#/$defs/relativePath" },
        "repository": { "type": "string" },
        "moved-to": { "$ref": "#/$defs/movedTo" },
        "docs": { "type": "string", "format": "uri" },
        "release": { "$ref": "#/$defs/release" },
        "exports": { "type": "array", "items": { "$ref": "#/$defs/export" } }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "channel": { "type": "string" },
        "tags": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "movedTo": {
      "type": "object",
      "required": ["git"],
      "properties": {
        "git": { "type": "string" },
        "path": { "$ref": "#/$defs/relativePath" },
        "notes": { "type": "string" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "required": ["ecosystem", "name"],
      "properties": {
        "ecosystem": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "notes": { "type": "string" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
        "card": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "contacts": { "type": "array", "items": { "$ref": "#/$defs/contact" } },
        "trust": { "$ref": "#/$defs/trust" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "required": ["intents", "kind"],
      "properties": {
        "intents": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "kind": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "url": { "type": "string" },
        "skill": { "type": "string" },
        "address": { "type": "string" },
        "subject-prefix": { "type": "string" },
        "repo": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "template": { "type": "string" },
        "project": { "type": "string" },
        "organization": { "type": "string" },
        "issue-type": { "type": "string" },
        "channel": { "type": "string" },
        "handle": { "type": "string" },
        "server": { "type": "string" },
        "method": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "content-type": { "type": "string" },
        "body": { "type": "string" },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "stdin": { "type": "string" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["github-issue", "gitlab-issue", "bitbucket-issue"] } }, "required": ["kind"] },
          "then": { "required": ["repo"] }
        },
        {
          "if": { "properties": { "kind": { "const": "gitea-issue" } }, "required": ["kind"] },
          "then": { "required": ["repo", "server"] }
        },
        {
          "if": { "properties": { "kind": { "const": "azure-boards" } }, "required": ["kind"] },
          "then": { "required": ["organization", "project"] }
        },
        {
          "if": { "properties": { "kind": { "const": "http" } }, "required": ["kind"] },
          "then": {
            "required": ["url"],
            "properties": { "url": { "type": "string", "pattern": "^https://" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "exec" } }, "required": ["kind"] },
          "then": {
            "required": ["command"],
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "prefixItems": [{ "type": "string", "minLength": 1, "pattern": "^[^/\\\\{}]+$" }],
                "items": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "trust": {
      "type": "object",
      "properties": {
        "signatures": { "type": "boolean" },
        "accepts-external": { "type": "boolean" },
        "jwks": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "keys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "origins": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^/]+$" }
        },
        "jwks-max-age": { "type": "string", "minLength": 1 }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "intents": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "consumers": { "$ref": "#/$defs/consumers" },
        "contact-budget": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "consumers": {
      "type": "object",
      "properties": {
        "may": { "type": "array", "items": { "type": "string" } },
        "may-not": { "type": "array", "items": { "type": "string" } }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "vendor-dir": { "$ref": "#/$defs/relativePath" },
        "sync-targets": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
        "organisation": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "contact": { "$ref": "#/$defs/contactSettings" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "contactSettings": {
      "type": "object",
      "properties": {
        "allow-http": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https://[^/?#]+$" }
        },
        "allow-exec": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" }
        }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["git"],
      "properties": {
        "id": { "$ref": "#/$defs/moduleId" },
        "git": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "track": { "enum": ["locked", "floating"] },
        "wire": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "vendor": { "$ref": "#/$defs/vendor" },
        "shim": { "$ref": "#/$defs/shim" },
        "require": { "$ref": "#/$defs/require" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "shim": {
      "type": "object",
      "properties": {
        "exports": { "type": "array", "items": { "$ref": "#/$defs/export" } },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
        "notes": { "type": "string" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "vendor": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["submodule", "copy"] },
        "path": { "$ref": "#/$defs/relativePath" },
        "recursive": { "type": "boolean" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "require": {
      "type": "object",
      "properties": {
        "commits": { "enum": ["any", "signed"] },
        "signers": { "$ref": "#/$defs/relativePath" },
        "cards": { "enum": ["any", "signed"] },
        "card-origin": { "type": "boolean" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "commits": { "const": "signed" } }, "required": ["commits"] },
          "then": { "required": ["signers"] }
        }
      ]
    }
  }
}
