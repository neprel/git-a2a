# Local settings used by `make site-publish`. Never put real values in this file.
SITE_DEPLOY_HOST=
SITE_DEPLOY_USER=
SITE_DEPLOY_PORT=22
SITE_DEPLOY_PATH=

# Optional. With neither value, OpenSSH uses its normal local identity and known_hosts files.
SITE_DEPLOY_IDENTITY_FILE=
SITE_DEPLOY_KNOWN_HOSTS_FILE=
