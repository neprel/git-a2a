FROM golang:1.25.1-bookworm@sha256:c423747fbd96fd8f0b1102d947f51f9b266060217478e5f9bf86f145969562ee AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/git-a2a ./cmd/git-a2a \
    && CGO_ENABLED=0 go test -trimpath -c -o /out/nix-native.test ./adapters/nix

FROM nixos/nix:2.28.3@sha256:e623d73af9cac82d1b50784c83e0cf2a4b83bfd2cfe8d5b67809a2fc94e043ac

COPY --from=build /out/git-a2a /usr/local/bin/git-a2a
COPY --from=build /out/nix-native.test /usr/local/bin/nix-native.test
ENV GITA2A_IT_NIX=1 \
    GITA2A_CLI_BIN=/usr/local/bin/git-a2a \
    NIX_CONFIG="experimental-features = nix-command flakes"
ENTRYPOINT ["/usr/local/bin/nix-native.test", "-test.v", "-test.run=^TestPublicCLINixLifecycle$"]
